# Load through your process manager / secret manager. Never bundle this in Flutter.
# TurnosQR example; replace issuer/origins for other products.
DATABASE_PATH=/data/asystant.db
OPENROUTER_API_KEY=replace-with-server-key
ASYSTANT_BIND=0.0.0.0:8787
ASYSTANT_ORIGINS=https://app.turnosqr.com
# Use an independent random secret of >=32 bytes per product issuer.
# Example daily caps: USD 10 per tenant and USD 1 per user (1 USD = 1,000,000 micros).
ASYSTANT_PRODUCTS='[{"issuer":"turnosqr","secret":"REPLACE-WITH-A-RANDOM-SERVER-SECRET-32-BYTES-OR-MORE","daily_tenant_micros":10000000,"daily_user_micros":1000000,"models":["openai/gpt-oss-120b"],"default_model":"openai/gpt-oss-120b"}]'
# Price ceilings are EXAMPLE policy values, not a quote of the current tariff.
# On OpenRouter these become provider.max_price; on direct providers configure
# a conservative maximum applicable tariff before enabling a model.
ASYSTANT_MODELS='[{"id":"openai/gpt-oss-120b","provider":"openrouter","model":"openai/gpt-oss-120b","key_env":"OPENROUTER_API_KEY","input_micros_per_million":1000000,"output_micros_per_million":1000000,"max_input_tokens":65536,"max_output_tokens":2048}]'

# Optional embedded /admin panel. Generate a separate credential: openssl rand -hex 32
# ASYSTANT_ADMIN_TOKEN=REPLACE-WITH-AN-INDEPENDENT-RANDOM-ADMIN-CREDENTIAL
