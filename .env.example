# Load through your process manager / secret manager. Never bundle this in Flutter.
DATABASE_PATH=/data/asystant.db
OPENROUTER_API_KEY=replace-with-server-key
ASYSTANT_BIND=0.0.0.0:8787
ASYSTANT_ORIGINS=http://localhost:8080
# Use an independent random secret of >=32 bytes per product issuer.
ASYSTANT_PRODUCTS='[{"issuer":"my-product","secret":"REPLACE-WITH-A-RANDOM-SERVER-SECRET-32-BYTES-OR-MORE","daily_tenant_micros":10000000,"daily_user_micros":1000000,"models":["openai/gpt-oss-20b"],"default_model":"openai/gpt-oss-20b","client_models":[{"tenant":"customer-a","models":["openai/gpt-oss-20b"],"default_model":"openai/gpt-oss-20b","allow_selection":false}],"budget_overrides":[{"tenant":"customer-a","subject":null,"daily_micros":5000000}]}]'
# Price ceilings are EXAMPLE policy values, not a quote of the current tariff.
# On OpenRouter these become provider.max_price; on direct providers configure
# a conservative maximum applicable tariff before enabling a model.
ASYSTANT_MODELS='[{"id":"openai/gpt-oss-20b","provider":"openrouter","model":"openai/gpt-oss-20b","key_env":"OPENROUTER_API_KEY","input_micros_per_million":1000000,"output_micros_per_million":1000000,"max_input_tokens":32768,"max_output_tokens":2048}]'
